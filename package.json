{
  "name": "personal_portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(process.env.npm_execpath&&!process.env.npm_execpath.includes('npm'))throw new Error('Use npm, not yarn or pnpm')\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "compress:glb": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem -Path 'public/assets/solar/models' -Filter '*.glb' | Where-Object { $_.BaseName -notlike '*.opt' } | ForEach-Object { $in=$_.FullName; $out=Join-Path $_.DirectoryName ($_.BaseName + '.opt.glb'); gltf-transform optimize $in $out --compress draco }\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:suite": "playwright test --project=v2-chromium-desktop --project=v2-mobile-chrome",
    "bundle:check": "node scripts/bundle-check.cjs",
    "copy:draco": "node scripts/copy-draco.mjs",
    "prebuild": "npm run copy:draco",
    "postbuild": "node scripts/write-share-html.mjs",
    "lhci": "lhci autorun",
    "postinstall": "patch-package",
    "ci": "npm run build && npm run bundle:check"
  },
  "bundlesize": [
    {
      "path": "./dist/assets/v2-*.js",
      "maxSize": "50 kB",
      "compression": "gzip"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.3",
    "@gltf-transform/cli": "^4.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "bundlesize2": "^0.0.35",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^11.11.17",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "lucide-react": "^0.577.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "react-use-measure": "^2.1.7",
    "resend": "^6.12.2",
    "simple-icons": "^16.18.1",
    "suspend-react": "^0.1.3",
    "three": "^0.183.2"
  },
  "overrides": {
    "tmp": "^0.2.5",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  }
}
