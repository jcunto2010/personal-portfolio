# Previene instalar paquetes con install scripts no auditados
# en entornos de CI (Vercel, GitHub Actions)
ignore-scripts=false

# Fuerza que package-lock.json sea respetado estrictamente
# (equivale a npm ci — nunca actualiza versiones silenciosamente)
save-exact=true

# Previene que npm auto-instale paquetes de fuentes distintas al registry
audit=true

# Bloquea publicación accidental desde el repo
; Si alguna vez alguien corre `npm publish` en este repo, falla.
; Descomenta si no publicas paquetes en npm:
; dry-run=true

# Asegurar que el package-lock.json se actualice automáticamente
package-lock=true

# Usar legacy-peer-deps para evitar conflictos de dependencias
legacy-peer-deps=true
