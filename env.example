# ── Audio ───────────────────────────────────────────────────────────
# URL del archivo de audio del tema. En producción, apunta a un CDN externo.
# En local, omite esta variable para usar el fallback del archivo en /public.
# VITE_AUDIO_URL=https://assets.tudominio.com/shona-theme.mp3

# ── Analytics (activar siguiendo docs/t008-observability-activation.md) ──
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Error tracking (activar siguiendo docs/t008-observability-activation.md) ──
# VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ── App version (usado por Sentry para releases) ──────────────────────
# VITE_APP_VERSION=1.0.0
